rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Config: Anyone can read (for app release info & telemetry flag), no client can write
    match /config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Users: Only the authenticated user can read and write their own data & subcollections.
    //
    // The recursive {document=**} wildcard is LOAD-BEARING as of SCOPE_1.7.3 §2(a): a ride is now a
    // parent document plus a points/{chunk} subcollection, and this match is what authorises the
    // chunk writes. Narrowing it to a fixed depth — which looks like tightening — would deny every
    // chunk write and every cascade delete, and the failure would present as rides that silently
    // stop syncing rather than as a permissions error anyone would look for.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Feedback: anyone can create feedback; an authenticated author may read/delete only their own records.
    match /feedbacks/{feedbackId} {
      allow create: if 
          request.resource.data.keys().hasAll(['text', 'type', 'timestamp', 'uid']) &&
          request.resource.data.text is string && request.resource.data.text.size() <= 5000 &&
          request.resource.data.type is string &&
          (
            (request.auth != null && request.resource.data.uid == request.auth.uid) || 
            (request.auth == null && request.resource.data.uid == 'anonymous')
          );
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // SCOPE_1.8.7 §6.3 — operator broadcasts.
    //
    // World-readable and nobody-writable. Both halves matter:
    //
    // READ is open because a broadcast is a public operational notice — "sync is down", "this
    // build has a defect" — and the foreground read is the fallback that catches anyone the push
    // missed. It carries no personal data and is addressed to everyone by definition. Requiring
    // auth would silence exactly the local-only users this app is built for.
    //
    // WRITE is denied to every client, unconditionally. The endpoint writes through the Admin SDK,
    // which bypasses these rules, so `if false` costs nothing and closes the hole that matters: a
    // client-writable broadcasts collection would let any signed-in user post a notification to
    // every install on a HIGH-importance channel. That is the single worst thing this feature
    // could become, and it would be one permissive rule away.
    //
    // The clients re-validate every row through OperatorBroadcast.parse regardless. These rules are
    // the first gate, not the only one.
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
