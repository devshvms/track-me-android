<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".TrackMeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrackMe"
        tools:targetApi="31">

        <service
            android:name=".service.TrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key"/>

        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Group invites (§2.4, and §6.1 B5 — this app had no deep links at all).

                TWO filters on purpose. The custom scheme needs no verification, no hosted file and
                no Play-signing fingerprint, so it works the moment the app is installed, including
                sideloaded builds. That is what makes the landing page's "Open in TrackMe" button
                work today rather than after a DAL round trip — which is the external dependency
                §15.1 deferred join-by-link over in the first place.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="trackme" android:host="group" />
            </intent-filter>

            <!--
                The real App Link. Better UX — a plain https link opens straight into the app with
                no scheme in the URL — but ONLY once assetlinks.json is served AND its fingerprint
                matches the installed build. Until then Android simply opens the browser, which is
                a soft failure: the landing page still works and still offers the button above.

                pathPrefix "/g" covers /g, /g/ and /g/anything. The token rides in the FRAGMENT,
                which is never matched and never transmitted (A6).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="trackme.shvms.in"
                    android:pathPrefix="/g" />
            </intent-filter>
        </activity>


        <!-- Compose's Robolectric unit-test rule launches this activity as its host. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            tools:replace="android:exported" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- SCOPE_1.8.7 §6.3: operator broadcasts. Exported because FCM delivers to it; the
             payload is data-only and every field is validated by OperatorBroadcast.parse before
             anything is posted, so an unsigned message cannot reach the notification shade. -->
        <service
            android:name=".service.notifications.TrackMeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- TASK-289: receives the chooser's EXTRA_CHOSEN_COMPONENT so group_invite_sent counts
             actual sends rather than share-sheet presentations. Not exported: only the system
             delivers to it, via the PendingIntent handed to createChooser. -->
        <receiver
            android:name=".ui.community.GroupInviteChosenReceiver"
            android:exported="false" />

        <!-- TASK-305: the same pattern for exported share artifacts, so `export_shared` counts
             destinations actually chosen rather than share sheets opened. Not exported. -->
        <receiver
            android:name=".ui.history.ExportSharedReceiver"
            android:exported="false" />
    </application>

</manifest>
