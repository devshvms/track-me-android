<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- STOP_EXERCISE is deliberately absent: Android cannot confirm End headlessly (§3.4a). -->
    <capability android:name="actions.intent.START_EXERCISE">
        <intent
            android:action="in.shvms.trackme.action.VOICE_START"
            android:targetClass="in.shvms.trackme.voice.VoiceActionActivity"
            android:targetPackage="in.shvms.trackme">
            <parameter
                android:key="exercise_name"
                android:name="exercise.name" />
        </intent>
    </capability>

    <capability android:name="actions.intent.PAUSE_EXERCISE">
        <intent
            android:action="in.shvms.trackme.action.VOICE_PAUSE"
            android:targetClass="in.shvms.trackme.voice.VoiceActionActivity"
            android:targetPackage="in.shvms.trackme" />
    </capability>

    <capability android:name="actions.intent.RESUME_EXERCISE">
        <intent
            android:action="in.shvms.trackme.action.VOICE_RESUME"
            android:targetClass="in.shvms.trackme.voice.VoiceActionActivity"
            android:targetPackage="in.shvms.trackme" />
    </capability>

    <!-- Inline inventory makes the spoken persona a stable RidePersona identifier. -->
    <shortcut android:shortcutId="PERSONA_AUTO">
        <capability-binding android:key="actions.intent.START_EXERCISE">
            <parameter-binding
                android:key="exercise.name"
                android:value="@array/voice_persona_auto_names" />
        </capability-binding>
    </shortcut>
    <shortcut android:shortcutId="PERSONA_WALK">
        <capability-binding android:key="actions.intent.START_EXERCISE">
            <parameter-binding
                android:key="exercise.name"
                android:value="@array/voice_persona_walk_names" />
        </capability-binding>
    </shortcut>
    <shortcut android:shortcutId="PERSONA_RUN">
        <capability-binding android:key="actions.intent.START_EXERCISE">
            <parameter-binding
                android:key="exercise.name"
                android:value="@array/voice_persona_run_names" />
        </capability-binding>
    </shortcut>
    <shortcut android:shortcutId="PERSONA_CYCLING">
        <capability-binding android:key="actions.intent.START_EXERCISE">
            <parameter-binding
                android:key="exercise.name"
                android:value="@array/voice_persona_cycling_names" />
        </capability-binding>
    </shortcut>
    <shortcut android:shortcutId="PERSONA_BIKE_DRIVE">
        <capability-binding android:key="actions.intent.START_EXERCISE">
            <parameter-binding
                android:key="exercise.name"
                android:value="@array/voice_persona_bike_drive_names" />
        </capability-binding>
    </shortcut>
    <shortcut android:shortcutId="PERSONA_CAR_DRIVE">
        <capability-binding android:key="actions.intent.START_EXERCISE">
            <parameter-binding
                android:key="exercise.name"
                android:value="@array/voice_persona_car_drive_names" />
        </capability-binding>
    </shortcut>
</shortcuts>
