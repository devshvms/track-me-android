<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_drive"
        android:enabled="true"
        android:icon="@drawable/ic_car"
        android:shortcutShortLabel="@string/shortcut_drive_short"
        android:shortcutLongLabel="@string/shortcut_drive_long">
        <intent
            android:action="in.shvms.trackme.action.QUICK_START"
            android:targetPackage="in.shvms.trackme"
            android:targetClass="in.shvms.trackme.MainActivity">
            <extra
                android:name="in.shvms.trackme.extra.QUICK_START_PERSONA"
                android:value="CAR_DRIVE" />
            <extra
                android:name="in.shvms.trackme.extra.QUICK_START_SOURCE"
                android:value="SHORTCUT" />
        </intent>
    </shortcut>
