<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude Room Database containing GPS coordinates history -->
    <exclude domain="database" path="trackme_db"/>
    <exclude domain="database" path="trackme_db-wal"/>
    <exclude domain="database" path="trackme_db-shm"/>
    
    <!-- Exclude Sensitive Shared Preferences containing credentials/session tokens -->
    <exclude domain="sharedpref" path="trackme_prefs.xml"/>
    <exclude domain="sharedpref" path="sync_prefs.xml"/>
</full-backup-content>