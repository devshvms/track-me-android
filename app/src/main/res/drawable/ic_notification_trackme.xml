        android:pathData="M3.2,20.2c-0.55,0 -1,-0.45 -1,-1 0,-2.9 2.35,-5.25 5.25,-5.25 1.0,0 1.0,-1.5 0,-1.5 -1.24,0 -2.25,-1.01 -2.25,-2.25S6.21,8 7.45,8c0.55,0 1,0.45 1,1s-0.45,1 -1,1c-0.14,0 -0.25,0.11 -0.25,0.25s0.11,0.25 0.25,0.25c3.0,0 3.0,4.5 0,4.5 -1.79,0 -3.25,1.46 -3.25,3.25 0,0.55 -0.45,1 -1,1z" />
