<!--
  Notification small icon.

  Must be a flat white-on-transparent silhouette: Android tints the small icon with the
  notification's accent colour and discards everything but the alpha channel. A coloured or
  multi-tone drawable renders as a white blob on API 21+, which is why the platform stock
  `ic_menu_mylocation` this replaces looked wrong in the shade.

  Shape: a route line resolving into a location pin — the same idea as the launcher mark, reduced
  to one path so it stays legible at 24dp in a status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Pin head and point -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15.5,2C12.46,2 10,4.46 10,7.5c0,3.9 5.5,10.2 5.5,10.2s5.5,-6.3 5.5,-10.2C21,4.46 18.54,2 15.5,2zM15.5,9.6c-1.16,0 -2.1,-0.94 -2.1,-2.1s0.94,-2.1 2.1,-2.1 2.1,0.94 2.1,2.1 -0.94,2.1 -2.1,2.1z" />

    <!-- Track trailing away from the pin -->
